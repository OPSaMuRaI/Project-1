# ===========================================
# CreatorMind – Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.

# --- Supabase (Required) ---
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- AI: Script Generation (Pick one; add keys when ready) ---
# Option A: OpenAI (recommended: GPT-4.1 / GPT-4o)
OPENAI_API_KEY=sk-...

# Option B: Anthropic (Claude Sonnet)
# ANTHROPIC_API_KEY=sk-ant-...

# --- AI: Embeddings (for training memory / semantic search) ---
# Option A: OpenAI (text-embedding-3-small)
# Uses OPENAI_API_KEY above – no extra key if you use OpenAI for both.

# Option B: Voyage AI (separate key)
# VOYAGE_API_KEY=pa-...

# --- AI: Video transcript (for competitor video upload) ---
# Option A: AssemblyAI
# ASSEMBLYAI_API_KEY=your-assemblyai-key

# Option B: OpenAI Whisper (uses OPENAI_API_KEY)
# No extra key if you use OpenAI.

# --- Payments (Later – Stripe) ---
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...
